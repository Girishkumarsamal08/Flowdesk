      "item": [
        {
          "name": "1. Register Company",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techcorp.com\",\n  \"password\": \"SecurePass123!\",\n  \"companyName\": \"Tech Corp Solutions\",\n  \"category\": \"SaaS\",\n  \"domain\": \"techcorp.com\",\n  \"supportEmail\": \"support@techcorp.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/companies/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "companies", "register"]
            }
          }
        },
        {
          "name": "2. Login Company",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
