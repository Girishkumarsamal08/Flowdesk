# ═══════════════════════════════════════════════════════════════════
#  Flowdesk — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# Local development (SQLite via Prisma):
#   DATABASE_URL="file:../backend/prisma/dev.db"
# Production (PostgreSQL — Render/Railway/Supabase/Neon):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flowdesk_prod"

# ── Authentication ────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Must be long and random.
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"
# Token expiry (e.g. "7d", "24h", "30d")
JWT_EXPIRY="7d"

# ── Admin ─────────────────────────────────────────────────────────
# Secret header value required for all /api/admin/* routes.
ADMIN_SECRET="change_me_to_a_secure_admin_secret"

# ── AI / LLM ──────────────────────────────────────────────────────
# Provide at least ONE of these. OpenAI takes priority if both are set.
GROQ_API_KEY="gsk_..."
OPENAI_API_KEY="sk-..."

# ── Chat Behaviour ────────────────────────────────────────────────
# Number of AI replies before a ticket is auto-escalated to a human.
ESCALATION_REPLY_THRESHOLD=5

# ── Server ────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────
# In production, set to your frontend URL (e.g. https://yourapp.vercel.app)
# Leave as * for local development.
ALLOWED_ORIGIN=*

# ── Frontend (Next.js) ────────────────────────────────────────────
# Used by frontend API calls. Point to your backend URL.
NEXT_PUBLIC_API_URL=http://localhost:5001
